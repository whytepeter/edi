{
  "name": "edi-workspace",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:audio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:electron": "pnpm --filter @edi/desktop exec install-electron && pnpm --filter @edi/desktop exec node scripts/prepare-electron.mjs",
    "dev": "pnpm --filter @edi/desktop dev",
    "build": "pnpm --filter @edi/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "node --import tsx --disable-warning=ExperimentalWarning --test packages/*/src/*.test.ts tests/input/*.test.ts tests/agent/*.test.ts",
    "test:desktop": "node tests/desktop/smoke.mjs",
    "test:character": "node tests/desktop/character.mjs",
    "test:animation": "node tests/desktop/character-animation.mjs",
    "test:approval": "node tests/desktop/approval-bubble.mjs",
    "test:artifacts": "node --import tsx tests/desktop/artifacts.mjs",
    "test:agent": "pnpm build && node --test tests/agent/worker.test.mjs",
    "test:audio": "node --import tsx --test tests/audio/player.test.ts tests/audio/process.test.ts tests/audio/session.test.ts tests/audio/capture.test.ts tests/audio/transcription.test.ts tests/audio/voice-controller.test.ts tests/audio/cloud-voice.test.ts",
    "test:capture:native": "node tests/audio/capture-native.mjs",
    "test:grounding:native": "sh native/screen-capture/build.sh && node --import tsx tests/native/text-grounding.mjs",
    "test:pointer:visual": "sh native/screen-capture/build.sh && pnpm build && node --import tsx tests/native/pointer-visual.mjs",
    "test:transcription:native": "node --import tsx tests/audio/transcription-native.mjs",
    "test:audio:native": "pnpm build && node tests/audio/native.mjs",
    "package": "pnpm --filter @edi/desktop package",
    "build:native": "sh native/hotkey/build.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "koffi"
    ]
  }
}
