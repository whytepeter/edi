{
  "name": "edi-workspace",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "setup:electron": "pnpm --filter @edi/desktop exec install-electron",
    "dev": "pnpm --filter @edi/desktop dev",
    "build": "pnpm --filter @edi/desktop build",
    "typecheck": "pnpm --filter @edi/desktop typecheck",
    "test": "tsx --test packages/contracts/src/index.test.ts",
    "test:desktop": "node tests/desktop/smoke.mjs",
    "test:character": "node tests/desktop/character.mjs",
    "test:agent": "pnpm build && node --test tests/agent/worker.test.mjs",
    "test:audio": "node --import tsx --test tests/audio/player.test.ts tests/audio/process.test.ts tests/audio/session.test.ts tests/audio/capture.test.ts tests/audio/transcription.test.ts",
    "test:audio:live": "node --import tsx tests/audio/live.mjs",
    "test:capture:native": "node tests/audio/capture-native.mjs",
    "test:transcription:native": "node --import tsx tests/audio/transcription-native.mjs",
    "test:audio:native": "pnpm build && node tests/audio/native.mjs",
    "package": "pnpm --filter @edi/desktop package"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "tsx": "^4.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
